# Im Discord Developer Portal unter Bot -> Reset Token erzeugen.
DISCORD_TOKEN=

# Optional, aber fuer die Entwicklung empfohlen: Befehle werden nur auf
# diesem Server registriert und erscheinen dort sofort.
DISCORD_GUILD_ID=

# ComfyUI bleibt aus Sicherheitsgruenden lokal erreichbar.
COMFYUI_URL=http://127.0.0.1:8188

# Optional: Kommagetrennte Discord-Kanal-IDs. Leer = alle Kanaele.
ALLOWED_CHANNEL_IDS=

# Eine GPU sollte normalerweise nur einen Workflow gleichzeitig ausfuehren.
MAX_PARALLEL_JOBS=1
# Video-Workflows koennen auf AMD/ZLUDA deutlich laenger als Bilder dauern.
GENERATION_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO

